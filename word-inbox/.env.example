# Copy to .env and fill in. Never commit .env.

# Web login (single user).
APP_PASSWORD=change-me
# Signs login tokens. Leave empty to generate one in data/app_secret.
APP_SECRET=

# OpenAI-compatible API, same settings as the add-on's config.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Models the page's Model dropdown can switch lookups to (comma-separated).
# OPENAI_MODEL is always included and is what the app starts with; a choice
# made on the page lasts until the app restarts or redeploys.
OPENAI_MODELS=gpt-5-mini,gpt-5,gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
# Unlike in Anki, certificate checks work on a server; keep this true.
VERIFY_SSL=true

# AnkiWeb account. Leave the username empty to disable sync.
# The password is only needed until the first login; the server then keeps
# a sync key in data/sync_auth.json and you can remove it.
ANKIWEB_USERNAME=
ANKIWEB_PASSWORD=

# Deck selected by default in the web page.
DEFAULT_DECK=Default

# Host port (docker compose only).
PORT=8088
